{
  "app": {
    // Package identity is intentionally stable across the BitFun rename so
    // upgrades retain encrypted sessions, preferences, and watch handoff data.
    "bundleName": "com.bitfun.app",
    "vendor": "BitFun",
    "versionCode": 1,
    "versionName": "1.0.1",
    "buildVersion": "1",
    "icon": "$media:bitfun_app_icon",
    "label": "$string:app_name",
    "configuration": "$profile:configuration"
  }
}
