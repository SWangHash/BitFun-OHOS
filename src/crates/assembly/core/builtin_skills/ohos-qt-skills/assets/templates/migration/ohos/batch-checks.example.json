{
  "idle_timeout": 600,
  "steps": [
    {"name": "configure", "command": ["cmake", "-S", ".", "-B", "build/ohos", "-G", "Ninja"]},
    {"name": "build", "command": ["cmake", "--build", "build/ohos", "--", "-k", "0"], "timeout": 1800},
    {"name": "deploy", "command": ["python", "REPLACE_SKILL/scripts/deploy_qt_libs.py", "--project", "REPLACE_OHOS_PROJECT", "--library", "build/ohos/libREPLACE_APP_TARGET.so"]},
    {"name": "hap", "command": ["python", "REPLACE_SKILL/scripts/devecocli_build.py", "--project", "REPLACE_OHOS_PROJECT"]},
    {"name": "package-inspect", "command": ["python", "REPLACE_SKILL/scripts/hap_check.py", "--project", "REPLACE_OHOS_PROJECT"]},
    {"name": "device", "command": ["python", "REPLACE_SKILL/scripts/device_run.py", "run", "--project", "REPLACE_OHOS_PROJECT", "--migration-root", "migration/ohos", "--record"]}
  ]
}
