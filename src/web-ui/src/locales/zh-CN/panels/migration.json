  "phases": {
    "baseline": {
      "name": "环境准备",
      "description": "确认 Qt for HarmonyOS 发行版、HarmonyOS SDK 与 native 工具链、构建打包工具和工程模板都已就位并可用。",
      "short": "环境"
    },
    "inventory": {
      "name": "迁移项盘点",
      "description": "扫描源码与构建文件，列出需要迁移的 Qt 模块、平台相关代码、系统接口和第三方库，每项对应一个验收场景。",
      "short": "盘点"
    },
    "contract": {
      "name": "迁移方案确认",
      "description": "给出可行性结论并冻结迁移方案；删减、降级或替换功能必须经你确认后记录。",
      "short": "方案"
    },
    "pilot": {
      "name": "先行验证",
      "description": "在大范围改代码之前，用最小工程证明应用外壳、入口、Qt 链接、打包和一个高风险点能走通。",
      "short": "先行"
    },
    "implementation": {
      "name": "功能迁移",
      "description": "按依赖顺序逐项迁移功能：先编译三方库和应用，再根据编译结果小步修改源码，每项都有验证记录。",
      "short": "功能"
    },
    "features": {
      "name": "鸿蒙特性接入",
      "description": "应用能安装启动后，按方案接入选定的鸿蒙特性（如碰一碰、接续、分享）；方案未选特性时标记为不适用。",
      "short": "特性"
    },
    "diagnostics": {
      "name": "构建与问题修复",
      "description": "构建、打包、安装并在设备上运行应用；每次失败按首个根因记录，修复后再重试。",
      "short": "构建"
    },
    "handoff": {
      "name": "验收与交付",
      "description": "逐项验证验收场景，核对最终安装包内容和真机运行结果，输出迁移报告。",
      "short": "交付"
    }
  },
