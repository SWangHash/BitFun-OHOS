  "phases": {
    "baseline": {
      "name": "環境準備",
      "description": "確認 Qt for HarmonyOS 發行版、HarmonyOS SDK 與 native 工具鏈、建置打包工具和工程範本都已就位並可用。",
      "short": "環境"
    },
    "inventory": {
      "name": "遷移項盤點",
      "description": "掃描原始碼與建置檔案，列出需要遷移的 Qt 模組、平台相關程式碼、系統介面和第三方函式庫，每項對應一個驗收情境。",
      "short": "盤點"
    },
    "contract": {
      "name": "遷移方案確認",
      "description": "給出可行性結論並凍結遷移方案；刪減、降級或替換功能必須經你確認後記錄。",
      "short": "方案"
    },
    "pilot": {
      "name": "先行驗證",
      "description": "在大範圍修改程式碼之前，用最小工程證明應用外殼、入口、Qt 連結、打包和一個高風險點能走通。",
      "short": "先行"
    },
    "implementation": {
      "name": "功能遷移",
      "description": "依相依順序逐項遷移功能：先編譯第三方函式庫和應用，再根據編譯結果小步修改原始碼，每項都有驗證記錄。",
      "short": "功能"
    },
    "features": {
      "name": "鴻蒙特性接入",
      "description": "應用能安裝啟動後，依方案接入選定的鴻蒙特性（如碰一碰、接續、分享）；方案未選特性時標記為不適用。",
      "short": "特性"
    },
    "diagnostics": {
      "name": "建置與問題修復",
      "description": "建置、打包、安裝並在裝置上執行應用；每次失敗依首個根因記錄，修復後再重試。",
      "short": "建置"
    },
    "handoff": {
      "name": "驗收與交付",
      "description": "逐項驗證驗收情境，核對最終安裝套件內容和實機執行結果，輸出遷移報告。",
      "short": "交付"
    }
  },
