{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^ExecCommand$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"%USERPROFILE%\\.bitfun\\hooks\\rtk-hook.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
