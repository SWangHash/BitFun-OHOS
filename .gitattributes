#**
# Line-ending policy.
#
# Git for Windows defaults to `core.autocrlf=true`, which rewrites every text
# file to CRLF on checkout. Several BitFun paths break silently when that
# happens:
#
#   1. `src/apps/relay-server/*.sh` is embedded into the Desktop binary with
#      `include_str!` and uploaded verbatim to the relay host. A CR turns each
#      blank line into `$'\r': command not found`, and `set -e` aborts the
#      one-click deploy on the first one.
#   2. Rust raw string literals (`r#"..."#`) that hold remote bash carry the
#      checkout's CRLF into the generated scripts the same way.
#   3. Terminal shell-integration scripts are embedded with `include_str!` and
#      written to the generated `.zshrc`/`fish.fish`; a CR makes zsh fail to
#      parse `case ... in`.
#   4. Deployment artifacts are copied verbatim to POSIX hosts, where crontab
#      and systemd keep the trailing CR as part of the command or unit value.
#
# Force LF for everything that has to run on a POSIX host, regardless of where
# it was checked out. Windows-only scripts (`*.ps1`) are left alone — PowerShell
# reads LF fine and pinning them would churn every non-Windows working tree.
#**

/.gitattributes     text eol=lf
*.sh                text eol=lf
*.bash              text eol=lf
# Zsh/Fish integration scripts are embedded with `include_str!` and written to
# the terminal cache. A CR makes zsh fail to parse `case ... in`.
*.zsh               text eol=lf
*.fish              text eol=lf
*.rs                text eol=lf
*.py                text eol=lf
*.mjs               text eol=lf
*.cjs               text eol=lf

# pnpm patch files are parsed byte-exact by the patch engine on POSIX hosts;
# a CRLF checkout makes pnpm fail with ERR_PNPM_INVALID_PATCH ("invalid char
# in unquoted filename"). The lockfile patch hash is computed over LF-normalized
# bytes, so forcing LF also keeps the recorded hash stable on every platform.
*.patch             text eol=lf

# Generated frontend/mobile contracts compare exact file contents. Keep both
# their source fragments and generated outputs stable on every checkout so a
# Windows or hosted runner cannot report newline-only generated drift.
MiniApp/Demo/git-graph/source/** text eol=lf
src/crates/assembly/core/builtin_skills/miniapp-dev/references/examples/demo-git-graph/source/** text eol=lf
src/apps/mobile/**/*.json text eol=lf
src/apps/mobile/**/*.js text eol=lf
src/apps/mobile/**/*.ets text eol=lf
src/apps/mobile/**/*.kt text eol=lf
src/apps/mobile/**/*.swift text eol=lf

# The Product Operation Registry embeds and compares this generated JSON byte for byte.
src/crates/contracts/product-domains/src/generated/remote-surface-registry.json text eol=lf

# Release workflows byte-compare these pinned legacy updater feeds against the
# uploaded assets, so their newlines must survive every checkout unchanged.
scripts/fixtures/legacy-update-feeds/*.json text eol=lf

# Native icon export provenance hashes the exact source bytes on every platform.
assets/brand/macos/bitfun.icon/icon.json text eol=lf
assets/brand/macos/legacy-canvas.json text eol=lf

# models.dev provenance hashes exact redistributed bytes. Keep these assets
# stable across checkout platforms so the offline release check is reproducible.
src/crates/services/services-integrations/assets/models-dev.json text eol=lf
src/crates/services/services-integrations/assets/models-dev.LICENSE.txt text eol=lf
src/crates/services/services-integrations/assets/models-dev.provenance.json text eol=lf

# The bundled privacy statement is embedded with `include_str!` and its
# SHA-256 is verified at startup. A CRLF checkout changes the digest and makes
# OHOS report "privacy statement unavailable" on first launch.
src/crates/services/services-integrations/src/privacy/assets/*.md text eol=lf

# The Gradle wrapper is an extensionless POSIX shell script, so the `*.sh` rule
# above does not cover it. Its `.bat` sibling is the mirror case: cmd.exe needs
# CRLF. The wrapper jar is binary and must never be filtered.
gradlew             text eol=lf
gradlew.bat         text eol=crlf
*.jar               binary

# Node entrypoints may be executed through their `#!` shebang, where a trailing
# CR becomes part of the interpreter path (`node\r: not found`). `worker_host.js`
# is also shipped as a desktop resource, so keep the whole JS corpus LF.
*.js                text eol=lf
*.jsx               text eol=lf
*.mts               text eol=lf
*.cts               text eol=lf

# Frontend sources keep LF: the web-ui corpus is 99.8% LF and Windows editors
# have repeatedly flipped whole .ts/.tsx files to CRLF, polluting diffs with
# thousands of newline-only lines (commit 8db6e0b04 carried 7808 such lines).
# Pinned so a CRLF rewrite is normalized back to LF on add.
*.ts                text eol=lf
*.tsx               text eol=lf
*.scss              text eol=lf
*.css               text eol=lf

# Deployment artifacts are copied verbatim to POSIX hosts. crontab and systemd
# treat a trailing CR as part of the command/unit value, and nginx configs are
# easier to reason about when every platform produces the same bytes.
deploy/**           text eol=lf
*.cron              text eol=lf
*.service           text eol=lf
*.timer             text eol=lf

Dockerfile          text eol=lf
Dockerfile.*        text eol=lf
*.Dockerfile        text eol=lf
.dockerignore       text eol=lf
docker-compose.yml  text eol=lf
docker-compose.*.yml text eol=lf
Caddyfile           text eol=lf
